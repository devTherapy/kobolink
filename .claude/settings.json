{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write", "WebFetch", "WebSearch", "Task",
      "Bash(npm *)", "Bash(npx *)", "Bash(node *)", "Bash(pnpm *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add*)",
      "Bash(git commit*)", "Bash(git switch*)", "Bash(git checkout*)",
      "Bash(git branch*)", "Bash(git push*)", "Bash(git pull*)",
      "Bash(git rev-parse*)", "Bash(git worktree*)", "Bash(git fetch*)",
      "Bash(git restore*)", "Bash(git stash*)", "Bash(git merge*)",
      "Bash(gh pr *)", "Bash(gh repo *)", "Bash(gh run *)", "Bash(gh api *)",
      "Bash(gh variable *)", "Bash(gh secret list*)", "Bash(gh auth status*)",
      "Bash(docker *)", "Bash(psql *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(cat *)", "Bash(ls *)",
      "Bash(find *)", "Bash(sed *)", "Bash(grep *)", "Bash(head *)",
      "Bash(tail *)", "Bash(wc *)", "Bash(chmod +x *)", "Bash(curl *)",
      "Bash(jq *)", "Bash(python3 *)", "Bash(echo *)", "Bash(test *)",
      "Bash(xcodebuild *)", "Bash(xcrun *)", "Bash(adb *)", "Bash(./gradlew *)",
      "Bash(./scripts/*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commit.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/keep-going.sh" }
        ]
      }
    ]
  }
}
