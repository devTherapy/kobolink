# Copy to .env.local (gitignored) for `npm run dev -w apps/api` and for
# `drizzle-kit` commands run locally (`npx drizzle-kit generate`, etc).
#
# Integration tests (`npm run test:api`) ignore this entirely — they start
# their own Postgres via Testcontainers and set DATABASE_URL themselves.
#
# Never put a real password here or in any tracked file; USER/PASSWORD below
# are placeholders, not defaults — nothing in this app falls back to a
# built-in connection string.

DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/kobolink

# The port `npm run dev -w apps/api` listens on (see src/main.ts).
PORT=3001

# Trust the X-Forwarded-For header for the login rate limiter's per-IP
# bucket (src/auth/client-ip.ts). Leave unset/empty locally and in any
# deployment with no reverse proxy in front of it — an untrusted client can
# put whatever it likes in that header and walk straight past the per-IP
# limit by claiming a new address on every request. Set to 1 only behind a
# real proxy/load balancer that itself sets (and overwrites) the header.
TRUST_PROXY=

# Optional, read only by `npm run db:seed -w apps/api` (src/db/seed.ts).
# Plaintext password to hash (argon2id) for the seeded merchant
# (merchant@kobolink.dev). Left empty here deliberately — no real or
# placeholder password value belongs in a tracked file. Set your own in
# .env.local before running the seed script; leave it unset (as here) and
# the seed script still creates the external_funding ledger account, but
# skips the merchant/account/links.
SEED_MERCHANT_PASSWORD=
