<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant manifest override, merged only into debug builds — never
  release. It exists solely to point networkSecurityConfig at
  res/xml/network_security_config.xml (see that file for why), which scopes
  cleartext HTTP to the dev API's emulator alias instead of allowing it
  app-wide. minSdk here is 26, above the API 24 floor for
  networkSecurityConfig, so no tools:targetApi override is needed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
