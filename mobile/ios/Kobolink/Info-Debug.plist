<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug. Merged with the keys Xcode generates from INFOPLIST_KEY_* build settings. -->
	<key>KobolinkAPIBaseURL</key>
	<string>$(KOBOLINK_API_BASE_URL)</string>
	<!-- The custom scheme kobolink://l/{code}: needs no entitlement, so it works for a free personal team and in the Simulator. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.folusayo.kobolink.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kobolink</string>
			</array>
		</dict>
	</array>
	<!-- Debug only (Release uses Info.plist): lets the app reach http://localhost; does not open arbitrary http. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
