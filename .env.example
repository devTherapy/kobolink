# Copy to .env.local (gitignored). Nothing here is read at build time except
# the font download in apps/web, which needs network, not an env var.

# ---- Database ---------------------------------------------------------------
# apps/api. Integration tests ignore this and start their own Postgres via
# Testcontainers; it is only for `npm run dev`. USER/PASSWORD are
# placeholders — fill in your own local database's credentials; nothing in
# apps/api falls back to a built-in connection string. See also
# apps/api/.env.example.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/kobolink

# ---- Dashboard stream -----------------------------------------------------------
# apps/api. How often GET /api/stream/dashboard sends its keepalive
# `heartbeat` event, in milliseconds. Leave unset for the default
# (packages/contracts's SSE_HEARTBEAT_MS, 15000) — see apps/api/.env.example.
DASHBOARD_HEARTBEAT_MS=
# apps/web. The same interval, as the browser needs to know it: a connection
# that is silent for 2.5x this is treated as dead and replaced. If you set
# DASHBOARD_HEARTBEAT_MS above, set this to the same number or a healthy but
# quiet stream is torn down and reconnected. Inlined at build time (NEXT_PUBLIC_).
# Keep both under 30000: Next's own /api/* proxy drops a proxied connection that
# is idle for 30s (apps/web/next.config.ts), which a longer heartbeat would trip.
NEXT_PUBLIC_DASHBOARD_HEARTBEAT_MS=

# ---- Auth ---------------------------------------------------------------------
# apps/api. Trust X-Forwarded-For for the login rate limiter's per-IP bucket.
# Leave unset unless a real reverse proxy sits in front of this deployment and
# itself sets (overwrites) the header — see apps/api/.env.example.
TRUST_PROXY=

# ---- Web -> API ----------------------------------------------------------------
# Locally Next.js proxies /api/* here so the browser only ever sees one origin.
API_ORIGIN=http://localhost:3001

# ---- Deep links ---------------------------------------------------------------
# The domain that serves the association files and the /l/:code pages.
# A universal link is a contract with ONE hostname: this exact host must serve
# /.well-known/apple-app-site-association over HTTPS with no redirects.
# The apex (folusayo.com) is deliberately NOT used — it is already pointed
# elsewhere, and claiming it would hand every URL on the personal domain to the app.
NEXT_PUBLIC_LINK_DOMAIN=pay.folusayo.com

# Apple: <TEAM_ID>.<bundle id>, e.g. ABCDE12345.com.folusayo.kobolink. Left
# empty deliberately — the AASA route handler 503s rather than serving a
# placeholder Team ID, which Apple's CDN would then cache for up to 24 hours
# with no way to invalidate it. Fill in your real Team ID before `npm run dev`
# will serve a 200 from /.well-known/apple-app-site-association.
APPLE_APP_ID=

# Android: comma-separated UPPERCASE colon-separated SHA-256 fingerprints.
# Include BOTH your debug keystore and the Play App Signing fingerprint.
ANDROID_PACKAGE_NAME=com.folusayo.kobolink
ANDROID_SHA256_FINGERPRINTS=

# apps/web, /l/[code]'s generateMetadata. The numeric App Store id for the
# iOS Smart App Banner (<meta name="apple-itunes-app">) on the public
# checkout page. Left unset, the tag is simply omitted — never invent one.
NEXT_PUBLIC_IOS_APP_STORE_ID=

# ---- Deployment (Fly.io) — NAMES ONLY, never put values in a tracked file ----
# Nothing below is read by `npm run dev`; it is the list of what production
# needs and where each one lives. Setup, commands and owner steps: docs/DEPLOY.md.
#
# Fly secrets, `fly secrets set -a kobolink-api` (api app):
#   DATABASE_URL                     Postgres connection string (also set by `fly postgres attach`)
# Fly secrets, `fly secrets set -a kobolink-web` (web app):
#   APPLE_APP_ID                     <TEAM_ID>.com.folusayo.kobolink  (see the Apple block above)
#   ANDROID_SHA256_FINGERPRINTS      uppercase, comma-separated (see the Android block above)
# Not secrets — already in apps/*/fly.toml: API_ORIGIN, ANDROID_PACKAGE_NAME,
#   DASHBOARD_HEARTBEAT_MS, NEXT_PUBLIC_DASHBOARD_HEARTBEAT_MS, PORT.
#
# GitHub Actions (.github/workflows/deploy.yml):
#   secret FLY_API_TOKEN             an ORG-scoped Fly token (one workflow deploys two apps; an app-scoped
#                                    deploy token would be rejected for the second): `fly tokens create org`
#   var    DOMAIN                    pay.folusayo.com
#   var    EXPECTED_APP_ID           same value as APPLE_APP_ID
#   var    SMOKE_LINK_CODE           optional: a real link code to render-check
